{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering OS Task",
  "type": "object",
  "required": ["id", "type", "status", "title", "owner", "acceptanceCriteria", "changedLocations", "evidenceIds"],
  "properties": {
    "id": { "type": "string", "pattern": "^TASK-[0-9]{8}-[0-9]{3}$" },
    "type": { "const": "task" },
    "status": { "enum": ["active", "blocked", "handoff", "complete"] },
    "title": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "changedLocations": { "type": "array", "items": { "type": "string" } },
    "evidenceIds": { "type": "array", "items": { "type": "string" } },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "lessonId"],
        "properties": {
          "id": { "type": "string", "pattern": "^INC-" },
          "lessonId": { "type": "string", "pattern": "^LES-" }
        }
      }
    }
  }
}
